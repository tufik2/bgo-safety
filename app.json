{
  "expo": {
    "name": "BGO Safety",
    "slug": "bgo-safety",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.refineddata.bgosafety"
    },
    "android": {
      "package": "com.refineddata.bgosafety",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#11171C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#065CFE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BGO Safety uses your location to find the property you're at."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BGO Safety uses the camera to attach photos to inspections.",
          "photosPermission": "BGO Safety lets you attach photos from your library to inspections."
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "bgosafety",
    "extra": {
      "eas": {
        "projectId": "eb7ec93d-4f49-4e65-ba2c-b6940058651e"
      }
    }
  }
}
